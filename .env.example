# Database
DATABASE_URL=postgresql://user:password@localhost:5432/bonistock_dev

# Auth.js
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth - Facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# OAuth - Apple (web)
# APPLE_OAUTH_CLIENT_ID=
# APPLE_OAUTH_CLIENT_SECRET=

# Native mobile OAuth (id_token exchange) — optional until the Flutter apps ship
# GOOGLE_IOS_CLIENT_ID=
# GOOGLE_ANDROID_CLIENT_ID=
# APPLE_NATIVE_CLIENT_ID=com.bonifatus.bonistock

# Google Play Billing (Android IAP) — optional until the Android app ships
# Service-account JSON (single line) with Play Console order-management permission
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# OIDC audience configured on the Pub/Sub push subscription for RTDN
# GOOGLE_PLAY_PUBSUB_AUDIENCE=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (Brevo SMTP)
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
EMAIL_FROM=Bonistock <no-reply@bonistock.com>

# Encryption (32 bytes hex = 64 hex chars)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# Financial Modeling Prep
FMP_API_KEY=

# Stock sync (dev only — set to prod URL to copy stocks instead of calling FMP)
# STOCK_SYNC_SOURCE=https://bonistock.com

# Analytics - PostHog (build-time, baked into client bundle)
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Analytics - Google (build-time, baked into client bundle)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-...

# Google Ads Conversion Tracking (build-time, baked into client bundle)
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-...

# Sentry
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
